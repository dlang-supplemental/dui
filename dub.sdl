name "dui"
description "App-kit on top of dew — state helpers and higher-level UI sugar for D"
authors "amdphreak"
copyright "Copyright © 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.3"

targetType "library"
targetName "dui"

# Co-dev / CI: sibling checkout of dew (see .github/workflows/ci.yml).
# Before tagging a DUB release, flip to: dependency "dew" version="~>0.1.6"
dependency "dew" path="../dew"
dependency "tgc" version="~>0.1.1"

configuration "library" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "DewHeadless"
}

configuration "unittest" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "Tgc_default" "DewHeadless"
}
