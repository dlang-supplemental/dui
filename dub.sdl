name "dui"
description "App-kit on top of dew — state helpers and higher-level UI sugar for D"
authors "amdphreak"
copyright "Copyright © 2026, dlang-supplemental contributors"
license "BSL-1.0"
version "0.1.5"

targetType "library"
targetName "dui"

dependency "dew" version="~>0.1.6"
dependency "tgc" version="~>0.1.1"

libs "user32" platform="windows"

configuration "library" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	# Do not set versions "DewHeadless" here — DUB applies dependency versions to
	# the root package, which would force dew's Vello stubs even when a host
	# selects subConfiguration "dew" "gpu". Dew's default library config is already headless.
}

configuration "unittest" {
	targetType "library"
	importPaths "source"
	sourcePaths "source"
	stringImportPaths "."
	versions "Tgc_default" "DewHeadless"
}
